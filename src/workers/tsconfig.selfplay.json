{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "rootDir": "../..",
    "outDir": "../../.shared-build",
    "typeRoots": [
      "../../frontend/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "./self_play_shared.ts",
    "./sprt_shared.ts",
    "./model_runtime.ts",
    "../../frontend/src/engine/board.ts",
    "../../frontend/src/engine/search.ts",
    "../../frontend/src/engine/nnue-core.ts"
  ]
}
